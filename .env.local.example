# Copy to .env.local and fill in values.

# Mongo connection string. If unset, blog will fall back to static sample data.
MONGODB_URI="mongodb://localhost:27017/simplifyqa"

# Canonical site URL — used for sitemap, OG, JSON-LD. Override in production.
NEXT_PUBLIC_SITE_URL="https://www.simplifyqa.app"

# Session signing secret for /admin (min 24 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Image upload service (the self-hosted oracle-uploadthing instance).
UPLOADTHING_BASE_URL="https://uploads.simplifyqa.app"
UPLOADTHING_API_TOKEN=""
UPLOADTHING_PROJECT="simplifyqa-blog"

# Optional: logo.dev token for higher-quality customer logos on the trust bar.
NEXT_PUBLIC_LOGO_DEV_TOKEN=""
